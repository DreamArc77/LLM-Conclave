# ============================================================
# LLM Conclave — Environment Variables
# Copy this file to .env.local and fill in your values.
# All settings are optional — you can configure models in the UI.
# ============================================================

# ---- Export (PDF/PNG) --------------------------------------
# Path to Chromium/Chrome binary for server-side PDF/PNG export.
# Default works inside the official Docker image.
# macOS: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Linux: /usr/bin/chromium-browser  or  /usr/bin/google-chrome
CHROMIUM_PATH=/usr/bin/chromium-browser

# ---- In-memory job store -----------------------------------
# Keep true for single-instance deployments (default).
REDIS_DISABLED=true
